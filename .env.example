# Environment Variables — ugt-lube-monitoring
# Copy this file to .env.local and fill in the values. NEVER commit .env.local.
# Canonical org layout — same order as the `environment:` block in docker-compose*.yml.

# ─── 1. App + runtime (always) ───────────────────────────────────────────────
# /<basePath> when served under a basePath (with leading slash), empty = domain root.
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_APP_NAME=UGT Reliability Lube Monitoring
# Full URL incl. basePath — used for links in emails and CI build args
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Host port for docker compose (container port is always 3000). Not read by `next dev`.
APP_PORT=3000
# Org standard: always on (internal-CA certs on a closed intranet).
NODE_TLS_REJECT_UNAUTHORIZED=0
# Host cron → /api/cron/weekly-digest and /api/cron/attachments-sweep.
# openssl rand -base64 32 — different in prod and dev.
CRON_SECRET=

# ─── 2. Database — MS SQL Server (always) ────────────────────────────────────
# Format: sqlserver://HOST:PORT;database=DB;user=USER;password=PASS;encrypt=true;trustServerCertificate=true
DATABASE_URL="sqlserver://CHANGE_ME_DB_HOST:1433;database=UGT_LubeMonitoring;user=CHANGE_ME_DB_USER;password=CHANGE_ME_DB_PASSWORD;encrypt=true;trustServerCertificate=true"
# DEV ONLY — empty database `prisma migrate dev` may wipe. Delete if the dev login may CREATE DATABASE.
SHADOW_DATABASE_URL="sqlserver://CHANGE_ME_DB_HOST:1433;database=UGT_LubeMonitoring_shadow;user=CHANGE_ME_DB_USER;password=CHANGE_ME_DB_PASSWORD;encrypt=true;trustServerCertificate=true"

# ─── 3. Auth (ugt-nextjs-auth-setup) ─────────────────────────────────────────
# openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_min_32_chars_use_openssl_rand_base64_32
# REQUIRED — bare origin, NO basePath.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Org mail domains, comma-separated, first = canonical
ORG_EMAIL_DOMAINS=ube.co.th
# Keycloak SSO — the org realm, this project's own client
KEYCLOAK_ISSUER=https://KEYCLOAK_HOST/realms/REALM
KEYCLOAK_CLIENT_ID=ugt-lube-monitoring
KEYCLOAK_CLIENT_SECRET=CHANGE_ME

# ─── 4. Mail (ugt-nextjs-mail-setup) ─────────────────────────────────────────
# SMTP_HOST empty = mail is not sent (dev). Ask the admin team (docs/admin-handoff.md).
SMTP_HOST=
SMTP_PORT=25
# true only for implicit TLS (465)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─── 5. Upload (ugt-nextjs-upload-setup) ─────────────────────────────────────
# Mount point of the Docker volume inside the container (writable by uid 1001).
STORAGE_ROOT=/app/storage
# 25 MB — raise nginx client_max_body_size to match
UPLOAD_MAX_BYTES=26214400

# ─── 6. Project-specific ─────────────────────────────────────────────────────
# AI diagnosis (server-only). Without AI_API_KEY the rule-based fallback answers.
AI_PROVIDER=glm
AI_API_KEY=
AI_MODEL=glm-5.2
# AI_BASE_URL=

# ─── 7. Misc ─────────────────────────────────────────────────────────────────
# Set to "1" to skip env validation (e.g. CI build that lacks secrets)
# SKIP_ENV_VALIDATION=1
